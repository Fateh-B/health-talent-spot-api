# Copier dans .env (ignoré par Git). Ne jamais utiliser de base réelle pour les tests.
APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=officine_test_demo
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
FRONTEND_ORIGINS=http://localhost:8080
PUBLIC_FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Développement uniquement : boîte email fictive MongoDB mail_outbox.
MAIL_MODE=local
# Préproduction : MAIL_MODE=smtp, HTTPS et base officine_staging* obligatoires.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
# CLAMAV_HOST=antivirus
# CLAMAV_PORT=3310
