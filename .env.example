# Configuration Officine Talents V2 (exemple, ne pas enregistrer de secrets ici)
# MONGODB_URI doit pointer vers une base de préproduction distincte.
MONGODB_URI=mongodb://localhost:27017
# SESSION_SECRET : chaîne aléatoire cryptographiquement forte, minimum 32 caractères.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Origines exactes des pages autorisées à appeler l'API, séparées par des virgules.
FRONTEND_ORIGINS=http://localhost:5173
# Production HTTPS : true + none ; développement HTTP local : false + lax.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
